#ifndef BDMVAUTHOR_CDRTOOLS_XCONFIG_H
#define BDMVAUTHOR_CDRTOOLS_XCONFIG_H

#define PROTOTYPES 1
#define HAVE_STDC_HEADERS 1
#define STDC_HEADERS 1
#define RETSIGTYPE void
#define APPID_DEFAULT "BDMV Author bundled mkisofs (cdrtools 3.02a09)"

#cmakedefine HAVE_ASSERT_H 1
#cmakedefine HAVE_STDARG_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_STDDEF_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_CTYPE_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_DIRENT_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_SYS_RESOURCE_H 1
#cmakedefine HAVE_SYS_PARAM_H 1
#cmakedefine HAVE_TIME_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_MEMORY_H 1
#cmakedefine HAVE_WCHAR_H 1
#cmakedefine HAVE_WCTYPE_H 1
#cmakedefine HAVE_ICONV_H 1

#cmakedefine TIME_WITH_SYS_TIME 1
#cmakedefine HAVE_STRUCT_TIMEVAL 1
#cmakedefine HAVE_STRUCT_TIMEZONE 1
#cmakedefine HAVE_STRUCT_TIMESPEC 1
#cmakedefine HAVE__DEV_NULL 1

/* Autoconf-compatible fallbacks for platforms (notably native MinGW-w64)
 * that do not provide the traditional POSIX ownership/link-count typedefs. */
#cmakedefine HAVE_UID_T 1
#cmakedefine HAVE_GID_T 1
#cmakedefine HAVE_NLINK_T 1
#ifndef HAVE_UID_T
#define uid_t int
#endif
#ifndef HAVE_GID_T
#define gid_t int
#endif
#ifndef HAVE_NLINK_T
#define nlink_t unsigned long
#endif

/* The host CRT already declares these globals/macros when these probes pass. */
#cmakedefine HAVE_ERRNO_DEF 1
#cmakedefine HAVE_ENVIRON_DEF 1

#cmakedefine HAVE_LARGEFILES 1
#cmakedefine HAVE_LONGLONG 1

/* Native UCRT names the 64-bit stdio seek/tell entry points differently. */
#cmakedefine BDMVA_MKISOFS_MAP_FSEEKO 1
#cmakedefine BDMVA_MKISOFS_MAP_FTELLO 1
#if defined(_WIN32) && defined(BDMVA_MKISOFS_MAP_FSEEKO)
#define fseeko _fseeki64
#endif
#if defined(_WIN32) && defined(BDMVA_MKISOFS_MAP_FTELLO)
#define ftello _ftelli64
#endif
#cmakedefine HAVE_FSEEKO 1
#cmakedefine HAVE_FTELLO 1
#cmakedefine HAVE_SNPRINTF 1
#cmakedefine HAVE_VSNPRINTF 1
#cmakedefine HAVE_STRCASECMP 1
#cmakedefine HAVE_STRNCASECMP 1
#cmakedefine HAVE_STRLCPY 1
#cmakedefine HAVE_STRLCAT 1
#cmakedefine HAVE_MEMMOVE 1
#cmakedefine HAVE_MEMCPY 1
#cmakedefine HAVE_MEMSET 1
#cmakedefine HAVE_GETCWD 1
#cmakedefine HAVE_STRERROR 1
#cmakedefine HAVE_RENAME 1
#cmakedefine HAVE_PUTENV 1
#cmakedefine HAVE_LSTAT 1
#cmakedefine HAVE_READLINK 1
#cmakedefine HAVE_SYMLINK 1
#cmakedefine HAVE_GETTIMEOFDAY 1
#cmakedefine HAVE_GETHOSTNAME 1
#cmakedefine HAVE_SELECT 1
#cmakedefine HAVE_GETPAGESIZE 1
#cmakedefine HAVE_MALLOC 1
#cmakedefine HAVE_CALLOC 1
#cmakedefine HAVE_REALLOC 1
#cmakedefine HAVE_DECL_STAT 1
#cmakedefine HAVE_DECL_LSTAT 1
#cmakedefine HAVE_FTRUNCATE 1
#cmakedefine HAVE_CHOWN 1
#cmakedefine HAVE_FCHOWN 1
#cmakedefine HAVE_CHMOD 1
#cmakedefine HAVE_FCHMOD 1
#cmakedefine HAVE_MKDIR 1
#cmakedefine HAVE_RMDIR 1
#cmakedefine HAVE_LINK 1
#cmakedefine HAVE_UNLINK 1
#cmakedefine HAVE_ACCESS 1
#cmakedefine HAVE_DUP 1
#cmakedefine HAVE_DUP2 1
#cmakedefine HAVE_PIPE 1
#cmakedefine HAVE_WAITPID 1
#cmakedefine HAVE_FORK 1
#cmakedefine HAVE_VFORK 1
#cmakedefine HAVE_NICE 1
#cmakedefine HAVE_SLEEP 1
#cmakedefine HAVE_USLEEP 1
#cmakedefine HAVE_SETREUID 1
#cmakedefine HAVE_SETEUID 1
#cmakedefine HAVE_SETUID 1
#cmakedefine HAVE_ISWPRINT 1
#cmakedefine HAVE_MBTOWC 1
#cmakedefine HAVE_WCTOMB 1
#cmakedefine HAVE_MBRTOWC 1
#cmakedefine HAVE_WCRTOMB 1
#cmakedefine HAVE_MBSINIT 1
#cmakedefine HAVE_ICONV 1
#cmakedefine HAVE_ICONV_OPEN 1
#cmakedefine HAVE_ICONV_CLOSE 1

#define SIZEOF_CHAR @SIZEOF_CHAR@
#define SIZEOF_SHORT_INT @SIZEOF_SHORT_INT@
#define SIZEOF_INT @SIZEOF_INT@
#define SIZEOF_LONG_INT @SIZEOF_LONG_INT@
#define SIZEOF_LONG_LONG @SIZEOF_LONG_LONG@
#define SIZEOF_CHAR_P @SIZEOF_CHAR_P@
#define SIZEOF_UNSIGNED_CHAR @SIZEOF_UNSIGNED_CHAR@
#define SIZEOF_UNSIGNED_SHORT_INT @SIZEOF_UNSIGNED_SHORT_INT@
#define SIZEOF_UNSIGNED_INT @SIZEOF_UNSIGNED_INT@
#define SIZEOF_UNSIGNED_LONG_INT @SIZEOF_UNSIGNED_LONG_INT@
#define SIZEOF_UNSIGNED_LONG_LONG @SIZEOF_UNSIGNED_LONG_LONG@

#define HOST_CPU "@BDMVA_MKISOFS_HOST_CPU@"
#define HOST_VENDOR "unknown"
#define HOST_OS "@BDMVA_MKISOFS_HOST_OS@"

#endif
