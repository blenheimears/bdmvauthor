file(READ "${SOURCE_DIR}/src/author.cpp" SRC)
file(READ "${SOURCE_DIR}/src/dvd_subpicture_palette.cpp" PALETTE)
foreach(NEEDLE IN ITEMS "fixed_bitmap_clut" "dvd_subpicture_title_palette_rgb" "bitmap_clut_file" "is_bitmap_subtitle")
  string(FIND "${SRC}" "${NEEDLE}" AT)
  if(AT LESS 0)
    message(FATAL_ERROR "DVD bitmap CLUT is not connected to authoring XML: ${NEEDLE}")
  endif()
endforeach()
string(FIND "${PALETTE}" "std::string dvd_subpicture_title_palette_rgb()" AT)
if(AT LESS 0)
  message(FATAL_ERROR "DVD bitmap CLUT generation missing")
endif()
