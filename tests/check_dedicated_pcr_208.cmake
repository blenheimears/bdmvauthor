# Production mux options must enable a dedicated PCR PID for BD and UHD BD.
# AVCHD keeps the muxer's previous behavior.
file(READ "${SOURCE_DIR}/src/author.cpp" author)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsMuxer.cpp" mux)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/muxerManager.cpp" manager)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/blurayHelper.cpp" helper)
foreach(token "target_is_avchd(target) ? \"\" : \" --no-pcr-on-video-pid\"" "validate_bluray_pcr_clip(entry.path(), clpi)" "const auto clpi = out / \"BDMV\" / \"CLIPINF\"")
  string(FIND "${author}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Blu-ray dedicated PCR contract missing: ${token}")
  endif()
endforeach()
foreach(token "paramPair[0] == \"--no-pcr-on-video-pid\"" "m_pmt.pcr_pid = DEFAULT_PCR_PID" "writeEmptyPacketWithPCR(newPCR)")
  string(FIND "${mux}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Muxer PCR stream implementation missing: ${token}")
  endif()
endforeach()
foreach(token "m_mainMuxer->parseMuxOpt(m_muxOpts)" "m_subMuxer->parseMuxOpt(m_muxOpts)")
  string(FIND "${manager}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Mux options not propagated to main and graphics muxers: ${token}")
  endif()
endforeach()
string(FIND "${helper}" "clpiParser.sequence_pcr_pid = muxer->getPCRPid();" found)
if(found LESS 0)
  message(FATAL_ERROR "CLPI metadata not derived from muxer PCR PID")
endif()
message(STATUS "Dedicated PCR mux and post-mux validation source contract passed")
