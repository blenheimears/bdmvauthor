if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR not supplied")
endif()
foreach(file CMakeLists.txt include/bdmvauthor/model.hpp include/bdmvauthor/author.hpp src/author.cpp src/gui.cpp src/cli.cpp src/project_file.cpp)
  file(READ "${SOURCE_DIR}/${file}" content)
  if(file STREQUAL "CMakeLists.txt")
    foreach(needle "third_party/libhdma/CMakeLists.txt" "LIBHDMA_ENABLE_SNDFILE_INPUT OFF" "add_subdirectory(third_party/libhdma" "install(TARGETS hdmaenc")
      string(FIND "${content}" "${needle}" pos)
      if(pos EQUAL -1)
        message(FATAL_ERROR "missing ${needle} in ${file}")
      endif()
    endforeach()
  endif()
endforeach()
file(READ "${SOURCE_DIR}/src/author.cpp" source)
# Reject the older 1,411,200-b/s core request; use standard 1,536,000-b/s nominal core.
string(FIND "${source}" "--bitrate 1411200" obsolete_bitrate)
if(NOT obsolete_bitrate EQUAL -1)
  message(FATAL_ERROR "libhdma authoring still requests the obsolete 1,411,200-b/s core")
endif()
foreach(needle "--raw-pcm" "--sample-rate" "--channels" "--bit-depth" "--lossless" "--bitrate 1536000" "--debug-core-melody" "--no-progress" "-f yuv4mpegpipe - |" "--pass 1 --pass-stats" "--pass 2 --pass-stats" "A_DTS" "probe_elementary_audio_peak_kbps")
  string(FIND "${source}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing process integration ${needle}")
  endif()
endforeach()
file(READ "${SOURCE_DIR}/src/gui.cpp" gui)
string(FIND "${gui}" "libhdma (lossless, experimental)" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "missing requested GUI codec label")
endif()
# Current libhdma names and trademarks are irrelevant: rely on raw PCM
# and output capability switches exposed by the supported CLI.
foreach(needle [=[hdma_help.contains("--raw-pcm")]=] [=[hdma_help.contains("--sample-rate")]=]
               [=[hdma_help.contains("--channel-layout")]=] [=[hdma_help.contains("--lossless")]=]
               [=[hdma_help.contains("--channels")]=] [=[hdma_help.contains("--bit-depth")]=] [=[hdma_help.contains("--xll-hardware-test")]=]
               [=[resolve_tool(config.hdmaenc,"hdmaenc",true)]=])
  string(FIND "${gui}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing hdmaenc GUI discovery: ${needle}")
  endif()
endforeach()
foreach(needle [=[info.channel_layout = text("channel_layout")]=] [=[source_info.channel_layout=="2.1"]=]
               [=[" --channel-layout "+layout]=] [=[" -channel_layout "+shq_s(ffmpeg_layout)]=])
  string(FIND "${source}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing 2.1 audio layout pass-through: ${needle}")
  endif()
endforeach()
message(STATUS "libhdma optional CLI integration and GUI discovery source checks ok")

file(READ "${SOURCE_DIR}/CMakeLists.txt" cmake_source)
foreach(needle "HDMA_BUNDLED_VERSION VERSION_LESS" "0.0.37" "supply libhdma 0.0.37 or newer")
  string(FIND "${cmake_source}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing minimum compatible encoder version check: ${needle}")
  endif()
endforeach()

# Retired profiles must not accidentally be selected for real discs.
foreach(needle [=[const std::string hdma_profile=]=] [=[" --lossless "+hdma_profile]=])
    string(FIND "${source}" "${needle}" pos)
    if(NOT pos EQUAL -1)
        message(FATAL_ERROR "retired profile selection survived in authoring code")
    endif()
endforeach()
string(FIND "${source}" [=[name=="blu-ray-compat" || name=="observed-5.1"]=] pos)
if(pos EQUAL -1)
    message(FATAL_ERROR "retired experimental options are not explicitly rejected")
endif()

# The explicit XLL upper bound is an ordinary codec-private option; it must
# remain permitted by model validation and passed through to the hdmaenc CLI.
file(READ "${SOURCE_DIR}/include/bdmvauthor/model.hpp" model)
string(FIND "${model}" [=["prediction-order"]=] blocked)
if(NOT blocked EQUAL -1)
  message(FATAL_ERROR "prediction-order was accidentally disallowed in advanced audio options")
endif()
foreach(option_name "prediction-order" "max-fixed-prediction-order" "xll-parameter-reuse" "xll-decorrelation" "xll-max-segments" "xll-hardware-test")
  string(FIND "${model}" "\"${option_name}\"" blocked)
  if(NOT blocked EQUAL -1)
    message(FATAL_ERROR "${option_name} was accidentally disallowed in advanced audio options")
  endif()
endforeach()
foreach(needle "hdmaVersion=0.0.37-xll-decorrelation-on-default" [=[opts<<" --"<<option.name]=] [=[if(option.has_value)opts<<" "<<shq_s(option.value)]=])
  string(FIND "${source}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing prediction-order integration or encoder-cache update: ${needle}")
  endif()
endforeach()

# The authoring frontend must force the known-good default even when a separately
# configured old external encoder is used; advanced options are appended later.
string(FIND "${source}" [=[" --channel-layout "+layout+" --lossless --bitrate 1536000 --xll-decorrelation on"+]=] default_decor)
if(default_decor EQUAL -1)
  message(FATAL_ERROR "libhdma default must enable decorrelation before user overrides")
endif()
string(FIND "${source}" [=[(debug_core_melody ? " --debug-core-melody" : "")+" --no-progress -o "+shq(out)+opts.str()]=] override_after_default)
if(override_after_default EQUAL -1 OR override_after_default LESS default_decor)
  message(FATAL_ERROR "libhdma advanced audio overrides must follow the default decorrelation option")
endif()
