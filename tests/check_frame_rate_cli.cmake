function(run_case name target rate expect_frame_error)
  execute_process(
    COMMAND "${CLI}" --target "${target}" --frame-rate "${rate}" ${ARGN} -o "${WORK_DIR}/${name}.iso" "${WORK_DIR}/${name}-missing-input.mkv"
    RESULT_VARIABLE rv OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(rv EQUAL 0)
    message(FATAL_ERROR "${name}: command unexpectedly succeeded")
  endif()
  set(text "${out}${err}")
  string(FIND "${text}" "frame-rate override" pos)
  if(expect_frame_error)
    if(pos EQUAL -1)
      message(FATAL_ERROR "${name}: expected frame-rate rejection, got: ${text}")
    endif()
  else()
    if(NOT pos EQUAL -1)
      message(FATAL_ERROR "${name}: legal frame-rate override was rejected: ${text}")
    endif()
    string(FIND "${text}" "missing title source" missing)
    if(missing EQUAL -1)
      message(FATAL_ERROR "${name}: expected validation to advance to missing source, got: ${text}")
    endif()
  endif()
endfunction()
run_case(uhd_2997 uhd 29.97p TRUE)
run_case(uhd_60 uhd 60p FALSE)
run_case(bd_25p bluray 25p FALSE)
run_case(bd_2997p bluray 29.97p FALSE)
run_case(bd_50i bluray 50i FALSE)
run_case(bd_60p bluray 60p TRUE)
run_case(dvd_film dvd film-dvd FALSE)
run_case(dvd_ntsc dvd ntsc-dvd FALSE)
run_case(dvd_pal dvd pal-dvd FALSE --menu-resolution 720x576)
run_case(dvd_60p dvd 60p TRUE)
message(STATUS "target-specific frame-rate CLI validation ok")

