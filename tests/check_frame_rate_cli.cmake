run_title_case(title_bd_24 bluray 24p FALSE)
run_title_case(title_bd_25p bluray 25p FALSE)
run_title_case(title_bd_2997p bluray 29.97p FALSE)
run_title_case(title_bd_60p bluray 60p TRUE)
run_title_case(title_uhd_50p uhd 50p FALSE)
run_title_case(title_dvd_film dvd film-dvd FALSE)
run_title_case(title_dvd_pal dvd pal-dvd FALSE --menu-resolution 720x576)

execute_process(
  COMMAND "${CLI}" --target dvd --title-frame-rate film-dvd "${WORK_DIR}/mixed-film-missing.mkv" --title-frame-rate ntsc-dvd "${WORK_DIR}/mixed-ntsc-missing.mkv"
  RESULT_VARIABLE mixed_ok_rv OUTPUT_VARIABLE mixed_ok_out ERROR_VARIABLE mixed_ok_err)
set(mixed_ok_text "${mixed_ok_out}${mixed_ok_err}")
string(FIND "${mixed_ok_text}" "DVD-Video cannot mix PAL titles" mixed_ok_bad)
if(NOT mixed_ok_bad EQUAL -1)
  message(FATAL_ERROR "DVD Film+NTSC combination was incorrectly rejected: ${mixed_ok_text}")
endif()

execute_process(
  COMMAND "${CLI}" --target dvd --title-frame-rate film-dvd "${WORK_DIR}/mixed-film-pal-missing.mkv" --title-frame-rate pal-dvd "${WORK_DIR}/mixed-pal-missing.mkv"
  RESULT_VARIABLE mixed_bad_rv OUTPUT_VARIABLE mixed_bad_out ERROR_VARIABLE mixed_bad_err)
set(mixed_bad_text "${mixed_bad_out}${mixed_bad_err}")
string(FIND "${mixed_bad_text}" "DVD-Video cannot mix PAL titles/resolutions with Film/NTSC titles/resolutions on the same disc" mixed_bad_pos)
if(mixed_bad_pos EQUAL -1)
  message(FATAL_ERROR "DVD Film+PAL incompatibility was not rejected: ${mixed_bad_text}")
endif()
