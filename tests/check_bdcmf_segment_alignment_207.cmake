# Verify tsMuxer defaults to 96-sector alignment for every ordinary M2TS,
# BDMV Author does not require a nonstandard flag, and the actual output is checked.
file(READ "${SOURCE_DIR}/src/author.cpp" author)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsMuxer.cpp" muxer)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsMuxer.h" header)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/muxerManager.cpp" manager)
foreach(token "mux_option_line.find(\" --blu-ray\")" "kBdcmfSegmentBytes" "kM2tsSourcePacketBytes" "found_stream" "multiple of 196608 bytes" "Rebuild the bundled tsMuxer")
  string(FIND "${author}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing unconditional Blu-ray preflight check: ${token}")
  endif()
endforeach()
foreach(token "kBdcmfSegmentAlign = 96 * MuxerManager::PHYSICAL_SECTOR_SIZE" "static_assert(kBdcmfSegmentAlign % 192 == 0)" "m_sectorSize = format == \"SSIF\" ? kLegacySectorAlign : kBdcmfSegmentAlign" "writeNullPackets(nullCnt / m_frameSize)" "processM2TSPCR(newPCR, pcrGAP)" "Backwards-compatible no-op")
  string(FIND "${muxer}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing automatic M2TS alignment implementation: ${token}")
  endif()
endforeach()
foreach(token "kM2tsSegmentSize = 96 * PHYSICAL_SECTOR_SIZE" "m_interleave ? BLURAY_SECTOR_SIZE : kM2tsSegmentSize" "m_subMuxer->setBlockMuxMode(SUB_INTERLEAVE_BLOCKSIZE - MAX_FRAME_SIZE, blockAlignment)" "m_mainMuxer->setBlockMuxMode(MAIN_INTERLEAVE_BLOCKSIZE - MAX_FRAME_SIZE, blockAlignment)")
  string(FIND "${manager}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Secondary clip overrides segment alignment: ${token}")
  endif()
endforeach()
string(FIND "${author}" "s << \" --bdcmf-align\"" explicit_flag)
if(NOT explicit_flag EQUAL -1)
  message(FATAL_ERROR "BDMV Author still requires --bdcmf-align")
endif()
string(FIND "${header}" "m_bdcmfSegmentAlignment" optin_member)
if(NOT optin_member EQUAL -1)
  message(FATAL_ERROR "tsMuxer still has opt-in alignment state")
endif()
math(EXPR segment_bytes "96 * 2048")
math(EXPR segment_packets "${segment_bytes} / 192")
if(NOT segment_bytes EQUAL 196608 OR NOT segment_packets EQUAL 1024)
  message(FATAL_ERROR "Invalid segment byte/packet count")
endif()
message(STATUS "Default M2TS alignment and BDMV Author preflight source contract passed")
