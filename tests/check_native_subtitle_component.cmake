if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR required")
endif()
file(READ "${SOURCE_DIR}/CMakeLists.txt" CMAKE_TEXT)
file(READ "${SOURCE_DIR}/src/author.cpp" ENGINE)
file(READ "${SOURCE_DIR}/src/cli.cpp" CLI)
file(READ "${SOURCE_DIR}/src/gui.cpp" GUI)
file(READ "${SOURCE_DIR}/include/bdmvauthor/author.hpp" HDR)
foreach(marker "BDMVAUTHOR_BUILD_BUNDLED_BDSUP2SUB" "third_party/bdsup2sub/CMakeLists.txt"
               "add_subdirectory(third_party/bdsup2sub" "TARGET bdsup2sub"
               "RUNTIME_OUTPUT_DIRECTORY" "install(TARGETS bdsup2sub")
  string(FIND "${CMAKE_TEXT}" "${marker}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Optional component CMake integration missing: ${marker}")
  endif()
endforeach()
foreach(marker "resolve_sibling_default_tool" "convert_bitmap_with_bdsup2sub"
               "tools_.bdsup2sub" " /tmerge:0 /forced-")
  string(FIND "${ENGINE}" "${marker}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Native converter engine integration missing: ${marker}")
  endif()
endforeach()
foreach(contents IN ITEMS CLI GUI HDR ENGINE)
  string(FIND "${${contents}}" "bdsup2sub_jar" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "Legacy Java/JAR dependency still referenced in ${contents}")
  endif()
endforeach()
foreach(marker "--bdsup2sub")
  string(FIND "${CLI}" "${marker}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "Native CLI option missing")
  endif()
endforeach()
message(STATUS "Optional native converter integration present and Java invocation removed")
