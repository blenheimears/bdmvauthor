# Fail the release if CLPI SequenceInfo regresses to a hard-coded PCR PID.
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsPacket.cpp" packet)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/blurayHelper.cpp" helper)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsMuxer.h" muxer)
file(READ "${SOURCE_DIR}/src/author.cpp" author)
foreach(token "writer.putBits(16, sequence_pcr_pid)" "sequence_pcr_pid")
  string(FIND "${packet}" "${token}" where)
  if(where LESS 0)
    message(FATAL_ERROR "Missing SequenceInfo runtime PCR PID: ${token}")
  endif()
endforeach()
string(FIND "${helper}" "clpiParser.sequence_pcr_pid = muxer->getPCRPid();" found)
if(found LESS 0)
  message(FATAL_ERROR "CLPI SequenceInfo must get PCR PID from the actual transport muxer PMT")
endif()
string(FIND "${muxer}" "getPCRPid() const" found)
if(found LESS 0)
  message(FATAL_ERROR "Muxer PCR PID must be accessible from PMT")
endif()
string(FIND "${packet}" "writer.putBits(16, DEFAULT_PCR_PID)" found)
if(NOT found LESS 0)
  message(FATAL_ERROR "Old hardcoded SequenceInfo PCR PID is still present")
endif()
string(FIND "${author}" "subClip\n" found)
# This release does not change BDMV Author menu transport model.
string(FIND "${author}" "subClip" found)
if(found LESS 0)
  message(FATAL_ERROR "Separate graphics subClip unexpectedly removed")
endif()
message(STATUS "CLPI PCR PID / graphics-only subclip source regression passed")
