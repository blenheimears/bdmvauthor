if(NOT DEFINED SOURCE_DIR OR NOT DEFINED CLI)
  message(FATAL_ERROR "SOURCE_DIR and CLI required")
endif()
file(READ "${SOURCE_DIR}/include/bdmvauthor/author.hpp" HEADER)
file(READ "${SOURCE_DIR}/src/author.cpp" AUTHOR)
file(READ "${SOURCE_DIR}/src/gui.cpp" GUI)
file(READ "${SOURCE_DIR}/src/cli.cpp" CLI_SOURCE)
file(READ "${SOURCE_DIR}/src/project_file.cpp" PROJECT)
foreach(needle "scaling_filter_backend = \"software\"" "tonemap_filter_backend = \"software\"" "filter_fallback_warning")
 string(FIND "${HEADER}" "${needle}" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "Hardware-filter defaults/callback missing: ${needle}")
 endif()
endforeach()
foreach(needle "tonemap_vaapi=format=nv12" "scale_vaapi=" "scale_qsv=" "scale_cuda=" "scale_vulkan=" "hwdownload,format=" "hwupload_cuda," "hardware_processing_filters" "selected_filter_device_options" "Software filtering fallback also failed" "filter_fallback_warning(warning)" "scalingFilter=" "tonemapFilter=" "hardwareDecode=" "fallback_filter_marker(cache_tmp_base)" "fallback_filter_marker(base)" "preserve_software_filter_fallback" "could not record software-filter fallback")
 string(FIND "${AUTHOR}" "${needle}" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "Hardware filtering pipeline/fallback/cache missing: ${needle}")
 endif()
endforeach()
foreach(needle "hardware/scalingFilter" "hardware/tonemapFilter" "hardware/filterDevice" "Video scaling filter" "HDR tone-mapping filter" "filter_warnings" "QMessageBox::warning(this,\"BDMV Author — hardware filter fallback\"")
 string(FIND "${GUI}" "${needle}" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "GUI setting/diagnostic missing: ${needle}")
 endif()
endforeach()
foreach(needle "--filter-scale" "--filter-tonemap" "--filter-device")
 string(FIND "${CLI_SOURCE}" "${needle}" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "CLI setting missing: ${needle}")
 endif()
endforeach()
foreach(needle "hardware/scalingFilter" "hardware/tonemapFilter" "hardware/filterDevice")
 string(FIND "${PROJECT}" "${needle}" pos)
 if(NOT pos EQUAL -1)
  message(FATAL_ERROR "Hardware filter settings must not be persisted inside .bdmvproject: ${needle}")
 endif()
endforeach()
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE rv OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rv EQUAL 0)
 message(FATAL_ERROR "--help failed: ${err}")
endif()
foreach(flag "--filter-scale" "--filter-tonemap" "--filter-device")
 string(FIND "${out}" "${flag}" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "--help missing: ${flag}")
 endif()
endforeach()
foreach(flag "--filter-scale" "--filter-tonemap")
 execute_process(COMMAND "${CLI}" "${flag}" definitely-invalid -o invalid.iso missing.mkv RESULT_VARIABLE rv OUTPUT_VARIABLE out ERROR_VARIABLE err)
 if(rv EQUAL 0)
  message(FATAL_ERROR "Invalid ${flag} unexpectedly accepted")
 endif()
 string(FIND "${out}${err}" "${flag} must be" pos)
 if(pos EQUAL -1)
  message(FATAL_ERROR "Invalid ${flag} did not produce a useful error: ${out}${err}")
 endif()
endforeach()
message(STATUS "Independent hardware filter settings, CLI validation, fallback, and cache routing present")
