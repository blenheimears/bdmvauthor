if(NOT DEFINED CLI)
  message(FATAL_ERROR "CLI missing")
endif()
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "bdmvauthor --help failed: ${err}")
endif()
foreach(needle "libhdma" "--hdmaenc")
  string(FIND "${out}${err}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing ${needle} in CLI help")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --target bluray --audio-codec libhdma dummy.mp4 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(FIND "${out}${err}" "missing title source" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "libhdma CLI selection failed: ${out}${err}")
endif()
message(STATUS "libhdma CLI selection checks ok")
