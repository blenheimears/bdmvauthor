# Keep the PMT locator based on the actual PAT: bundled tsMuxer uses 0x0100,
# and never assume 0x1000 is the PMT PID merely because PCR is at 0x1001.
file(READ "${SOURCE_DIR}/src/bluray_preflight.cpp" validator)
file(READ "${SOURCE_DIR}/tests/test_bluray_pcr_preflight.cpp" fixture)
file(READ "${SOURCE_DIR}/third_party/tsmuxer/tsMuxer/tsPacket.h" constants)
foreach(token "PsiSectionReader" "program_pmt_pid(*pat)" "pid == *pmt_pid" "missing valid PMT on PID declared by PAT" "mpeg_psi_crc")
  string(FIND "${validator}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "PAT-derived PMT validation regression: ${token}")
  endif()
endforeach()
foreach(token "pat(0x0100)" "pat(0x0350)" "multipart PMT reassembly" "corrupt PAT CRC" "wrong PMT clock PID")
  string(FIND "${fixture}" "${token}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing PAT/PMT fixture coverage: ${token}")
  endif()
endforeach()
string(FIND "${validator}" "pid == 0x1000" old)
if(NOT old EQUAL -1)
  message(FATAL_ERROR "PMT PID must not be hard-coded to 0x1000")
endif()
string(FIND "${constants}" "DEFAULT_PMT_PID = 256" found)
if(found LESS 0)
  message(FATAL_ERROR "Unexpected bundled tsMuxer PMT PID contract")
endif()
